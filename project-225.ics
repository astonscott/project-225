DTSTART;TZID=America/Chicago:20260913T110000
DTEND;TZID=America/Chicago:20260913T114500
SUMMARY:P225 · Baseline strength tests
DESCRIPTION:Countermovement jump\, seated 10 lb med ball side throws\, t
 rap bar deadlift 3RM. Enter on Plan → Setup.
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:P225 · Baseline strength tests
TRIGGER:-PT30M
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:P225 · Baseline strength tests
TRIGGER:-PT15M
