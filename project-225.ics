BEGIN:VEVENT
UID:w10-thu-gym3@project225
DTSTAMP:20260908T154719Z
DTSTART;TZID=America/Chicago:20261119T113000
DTEND;TZID=America/Chicago:20261119T124000
SUMMARY:P225 · Gym 3 · Lower hypertrophy + posterior chain
DESCRIPTION:Deadlift day. Horizontal and lateral jumps up front\, then t
 he volume that builds glutes and hamstrings.\n\nA1 Broad jump — 4×3\
 nA2 Lateral bound (stick the landing) — 4×3 / side\, continuous\nB T
 rap bar deadlift — 3×3 @ 85%\, then trap bar jump 3×3\nC Front squa
 t (or hack squat) — 3×5\nD1 Barbell hip thrust — 3×8\nD2 Nordic c
 url or lying leg curl — 3×6\nE1 Copenhagen plank — 3×30 s / side\
 nE2 Standing calf raise — 3×10\nE3 Farmer carry — 2×40 m
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:P225 · Gym 3 · Lower hypertrophy + posterior chain
TRIGGER:-PT30M
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:P225 · Gym 3 · Lower hypertrophy + posterior chain
TRIGGER:-PT15M
END:VALARM
END:VEVENT
